{
  "name": "object-counter",
  "version": "0.1.0",
  "private": true,
  "description": "Client-side object detection and counting for images, videos and webcam, powered by YOLOv8.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "bench": "node scripts/bench/runBrowserBench.ts",
    "e2e": "node scripts/e2e/imageFlow.ts",
    "e2e:video": "node scripts/e2e/videoFlow.ts",
    "e2e:clips": "node scripts/e2e/clipCounts.ts",
    "e2e:counts": "node scripts/e2e/countsFlow.ts",
    "e2e:webcam": "node scripts/e2e/webcamFlow.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "puppeteer-core": "^25.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "onnxruntime-web": "1.30.0"
  }
}
