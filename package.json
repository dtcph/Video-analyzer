{
  "name": "blob-analyzer",
  "version": "0.1.0",
  "description": "Browser-based video data visualization and blob tracking tool",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:tracker": "tsx scripts/trackerScenarios.ts",
    "test:detector": "tsx scripts/detectorScenarios.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:scenarios": "npm run test:detector && npm run test:tracker",
    "eval": "tsx scripts/evaluateClips.ts",
    "overlay": "tsx scripts/renderOverlay.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@techstark/opencv-js": "^5.0.0-release.1"
  }
}
